# Deployed as .npmrc by `vortex repo profile apply`.
#
# No registry auth line here on purpose: pnpm refuses to expand ${NPM_TOKEN} from a
# committed project .npmrc (a committed secret reference could leak to an attacker-
# redirected registry). npm auth belongs in your user-level ~/.npmrc, e.g.
#   //registry.npmjs.org/:_authToken=${NPM_TOKEN}
# which pnpm trusts and expands.
save-exact=true
# This repo uses pnpm (pnpm-lock.yaml). Block npm from ever writing a
# package-lock.json — npm honours this before tree resolution, so a stray
# `npm install` can't pollute the tree even though `only-allow pnpm` runs too late.
package-lock=false
